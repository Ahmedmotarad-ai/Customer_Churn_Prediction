# Copy to .env and adjust locally. NEVER commit .env (see .gitignore).
# Port the server listens on (Render injects its own PORT automatically).
PORT=8000
# Model artifact location (default: model.pkl next to app.py).
# MODEL_PATH=/srv/api/model.pkl
# Decision threshold on churn probability (default 0.5).
# CHURN_THRESHOLD=0.5
# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
